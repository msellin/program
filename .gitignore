# Secrets — never commit
.env
.env.*
!.env.example

# Local settings + IDE
.DS_Store
.wrangler/
.idea/
.vscode/
.claude/*
# Agent role definitions are project assets, not local state (2026-09-05).
# All fourteen — the six app auditors, five landing auditors, the design lead
# and the two evidence agents — lived only on one laptop. `run-app-audit.sh`
# dispatches them by name, so the script was in the repo and the things it
# dispatches were not: a fresh clone could not run the audit system this
# project depends on.
# settings.local.json, launch.json and worktrees stay ignored.
!.claude/agents/

# Node
node_modules/
.pnp
.pnp.js

# Next.js build outputs
.next/
out/
next-env.d.ts

# TypeScript
*.tsbuildinfo

# Testing / coverage
coverage/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Source medical PDFs — contain isikukood + provider identifiers.
# Kept locally for reference, never committed, never deployed.
source-pdfs/

# Real user log data — de-identified but personal.
data/log.json

# Backup / temp / scratch
*.bak
*~
.tmp/
